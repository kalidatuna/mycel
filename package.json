{
  "name": "mycel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first markdown knowledge base with on-device AI",
  "scripts": {
    "postinstall": "node scripts/touch-demo-vault.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
